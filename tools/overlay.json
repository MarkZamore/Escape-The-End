          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.81258b7c45d5e6c99bf2}\""
        },
        {
          "from": "\"Guardian of Darkness\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.700f9220d95975fdf370}\""
        },
        {
          "from": "\"Descend into the Deep Dark and defeat the Warden. Its drop is needed to craft the Eye.\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.4c4aabdaf9e9a748a277}\""
