        },
        {
          "from": "\"Corpse Warlock\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.1a7e011946220430d1f0}\""
        },
        {
          "from": "\"Servant of the Dark Cult\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.cdc3572f5b19df261f72}\""
        },
        {
          "from": "\"An undead warlock of a pagan cult. One of the four guardians of the Nether.\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.5b894b4f0fabe39176b9}\""
        },
        {
          "from": "\"The Way Home\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.29b32e8f0f0d86fbfe48}\""
        },
        {
          "from": "\"Return Home\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.d2f9ecbf6cc99b23d1fa}\""
        },
        {
          "from": "\"Ignite the Portal\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.376fc73d9578e3f5bd9d}\""
        },
        {
          "from": "\"Build the portal frame and ignite it with the Ignitium Flint and Steel. Home at last... or is it?\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.b38c13caf8d4d1064d40}\""
        },
        {
          "from": "\"Ignitium Flint and Steel\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.80d1102e25349de7dc2d}\""
        },
        {
          "from": "\"Key to the Portal\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.fcd86c2cf3fa8655876c}\""
        },
        {
          "from": "\"Forge a special flint and steel from Ignis's ingot — only it can ignite the portal home.\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.55cc69513825e8972b2e}\""
        },
        {
          "from": "\"Ignis\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.2c0e5cb050bdccb32c50}\""
        },
        {
          "from": "\"Lord of Flame\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.6a949fff4fb90252575b}\""
        },
        {
          "from": "\"Once all four guardians have fallen, Ignis will awaken. He drops an Ignitium Ingot — the key to the path home.\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.3c1ed3651ab337a62ec3}\""
        },
        {
          "from": "\"The Gauntlet\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.c0348a2f61ff993169c1}\""
        },
        {
          "from": "\"Blazing Fist\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.833515212b371949bc85}\""
        },
        {
          "from": "\"An enormous hand with a blazing eye. The last of the four guardians of the Nether.\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.96d217cf166c98e1ffc8}\""
        },
        {
          "from": "\"Netherite Monstrosity\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.7092e494d5579fdb80f0}\""
        },
        {
          "from": "\"Living Embodiment of Netherite\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.1eb68ca45ed54e8a19fc}\""
        },
        {
          "from": "\"A massive golem forged from ancient metal. One of the four guardians of the Nether.\"",
          "to": "\"{lanminecraft.escape_end_quests.0188f23907d5b573.5d0a44c923313313d4f4}\""
        }
      ]
