  "lanminecraft.escape_end_quests.0188f23907d5b573.29b32e8f0f0d86fbfe48": "Путь домой",
  "lanminecraft.escape_end_quests.0188f23907d5b573.2c0e5cb050bdccb32c50": "Игнис",
  "lanminecraft.escape_end_quests.0188f23907d5b573.376fc73d9578e3f5bd9d": "Зажечь портал",
  "lanminecraft.escape_end_quests.0188f23907d5b573.3c1ed3651ab337a62ec3": "Когда падут все четыре стража, пробудится Игнис. Из него выпадет игнитовый слиток — ключ к дороге домой.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.55cc69513825e8972b2e": "Выкуйте игнитиумное огниво из слитка Игниса. Только им можно зажечь портал домой.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.5b894b4f0fabe39176b9": "Восставший из мёртвых чародей языческого культа. Один из четырёх стражей Незера.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.5d0a44c923313313d4f4": "Огромный голем, выкованный из древнего металла. Один из четырёх стражей Незера.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.6a949fff4fb90252575b": "Владыка пламени",
  "lanminecraft.escape_end_quests.0188f23907d5b573.7092e494d5579fdb80f0": "Незеритовое чудище",
  "lanminecraft.escape_end_quests.0188f23907d5b573.80d1102e25349de7dc2d": "Игнитиумное огниво",
  "lanminecraft.escape_end_quests.0188f23907d5b573.833515212b371949bc85": "Пылающий кулак",
  "lanminecraft.escape_end_quests.0188f23907d5b573.96d217cf166c98e1ffc8": "Гигантская рука с пылающим глазом. Последний из четырёх стражей Незера.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.a58293cce7368624e5d6": "Побег из Незера",
  "lanminecraft.escape_end_quests.0188f23907d5b573.b38c13caf8d4d1064d40": "Постройте раму портала и зажгите её игнитиумным огнивом. Наконец-то дома… или нет?",
  "lanminecraft.escape_end_quests.0188f23907d5b573.c0348a2f61ff993169c1": "Перчатка Незера",
  "lanminecraft.escape_end_quests.0188f23907d5b573.cdc3572f5b19df261f72": "Служитель тёмного культа",
  "lanminecraft.escape_end_quests.0188f23907d5b573.d2f9ecbf6cc99b23d1fa": "Вернуться домой",
  "lanminecraft.escape_end_quests.0188f23907d5b573.fcd86c2cf3fa8655876c": "Ключ к порталу",
  "lanminecraft.escape_end_quests.2445868387220123.0170472199871a71c04a": "Око Неизвестности",
  "lanminecraft.escape_end_quests.2445868387220123.17b3c6267438314bf51f": "Предвестник",
  "lanminecraft.escape_end_quests.2445868387220123.1a1b9c1a8877d8518267": "Ключ к Сердцу",
  "lanminecraft.escape_end_quests.2445868387220123.1d4f7ffb16bdeafc9ce8": "Сердце Энда повержено. Возвращайтесь в настоящий, живой мир. Вы дома.",
  "lanminecraft.escape_end_quests.2445868387220123.22b77af01c6aaed3c80c": "Древние Останки",
  "lanminecraft.escape_end_quests.2445868387220123.264106ae8768f4ee9369": "Соберите добычу со всех владык Катаклизма, визера и хранителя и создайте Око Неизвестности. С его помощью вы сможете призвать Сердце Энда.",
  "lanminecraft.escape_end_quests.2445868387220123.27b0f7177e4ecfb58f24": "Древний ужас",
  "lanminecraft.escape_end_quests.2445868387220123.296ce80d248bc28be552": "Гигантское морское чудовище из затонувших городов.",
  "lanminecraft.escape_end_quests.2445868387220123.30132684ac208f3d873a": "Конец?",
  "lanminecraft.escape_end_quests.2445868387220123.34b6ec93863eabd28060": "Истинная концовка",
  "lanminecraft.escape_end_quests.2445868387220123.35aba87d27906de39aab": "Маледиктус",
  "lanminecraft.escape_end_quests.2445868387220123.3fbdee448627f4743737": "Левиафан",
  "lanminecraft.escape_end_quests.2445868387220123.4c4aabdaf9e9a748a277": "Спуститесь в Тёмные подземелья и одолейте хранителя. Его добыча понадобится, чтобы создать Око Неизвестности.",
  "lanminecraft.escape_end_quests.2445868387220123.525f340aa54d7cac725f": "Владыка глубин",
  "lanminecraft.escape_end_quests.2445868387220123.6706ba0f40762559b12d": "Древнее зло из проклятых пирамид.",
  "lanminecraft.escape_end_quests.2445868387220123.6a5cfa3e6a632019ba00": "Сцилла",
  "lanminecraft.escape_end_quests.2445868387220123.6e4624af4de56f82fb4f": "Осколок древности",
  "lanminecraft.escape_end_quests.2445868387220123.700f9220d95975fdf370": "Страж тьмы",
  "lanminecraft.escape_end_quests.2445868387220123.7410595ef1a39c5a0f7c": "Призовите и одолейте визера. Его звезда Незера понадобится, чтобы создать Око Неизвестности.",
  "lanminecraft.escape_end_quests.2445868387220123.81258b7c45d5e6c99bf2": "Хранитель",
  "lanminecraft.escape_end_quests.2445868387220123.8f061400891334de4b9b": "Сердце Энда",
  "lanminecraft.escape_end_quests.2445868387220123.9d841b6c5fb89cfd2d40": "Могущественнейший из владык Катаклизма.",
  "lanminecraft.escape_end_quests.2445868387220123.a0020819dbff4c867bd0": "Настоящий дом",
  "lanminecraft.escape_end_quests.2445868387220123.a1a1ad1a0eb486d66db7": "Последний босс",
  "lanminecraft.escape_end_quests.2445868387220123.a385167af9b9b5f9f437": "Голос бури",
  "lanminecraft.escape_end_quests.2445868387220123.a98fb241050f98300dd4": "Пробудившийся страж древней цитадели.",
  "lanminecraft.escape_end_quests.2445868387220123.afbc994364a2b8b4b48d": "Призовите Сердце Энда с помощью Ока Неизвестности и одолейте его. Лишь тогда откроется путь домой.",
