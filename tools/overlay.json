      "replacements": [
        {
          "from": "\"The End?\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.30132684ac208f3d873a}\""
        },
        {
          "from": "\t\t\t}]\r\n\t\t\ttitle: \"True Home\"",
          "to": "\t\t\t}]\r\n\t\t\ttitle: \"{lanminecraft.escape_end_quests.2445868387220123.a0020819dbff4c867bd0}\""
        },
        {
          "from": "\"True Home\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.a0020819dbff4c867bd0}\""
        },
        {
          "from": "\"True Ending\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.34b6ec93863eabd28060}\""
        },
        {
          "from": "\"The Heart of the End has fallen. Return to the real, living world. You're home.\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.1d4f7ffb16bdeafc9ce8}\""
        },
        {
          "from": "\"Heart of the End\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.8f061400891334de4b9b}\""
        },
        {
          "from": "\"Final Boss\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.a1a1ad1a0eb486d66db7}\""
        },
        {
          "from": "\"Use the Eye to summon and defeat the Heart of the End. Only then will the path home open.\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.afbc994364a2b8b4b48d}\""
        },
        {
          "from": "\"Eye of the Unknown\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.0170472199871a71c04a}\""
        },
        {
          "from": "\"Key to the Heart\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.1a1b9c1a8877d8518267}\""
        },
        {
          "from": "\"Use the drops from every Lord of the Cataclysm, along with those of the Wither and Warden, to craft the Eye of the Unknown — the key to summoning the Heart of the End.\"",
          "to": "\"{lanminecraft.escape_end_quests.2445868387220123.264106ae8768f4ee9369}\""
        },
        {
