  "lanminecraft.escape_end_quests.0188f23907d5b573.1a7e011946220430d1f0": "Corpse Warlock",
  "lanminecraft.escape_end_quests.0188f23907d5b573.1eb68ca45ed54e8a19fc": "Living Embodiment of Netherite",
  "lanminecraft.escape_end_quests.0188f23907d5b573.29b32e8f0f0d86fbfe48": "The Way Home",
  "lanminecraft.escape_end_quests.0188f23907d5b573.2c0e5cb050bdccb32c50": "Ignis",
  "lanminecraft.escape_end_quests.0188f23907d5b573.376fc73d9578e3f5bd9d": "Ignite the Portal",
  "lanminecraft.escape_end_quests.0188f23907d5b573.3c1ed3651ab337a62ec3": "Once all four guardians have fallen, Ignis will awaken. He drops an Ignitium Ingot — the key to the path home.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.55cc69513825e8972b2e": "Forge a special flint and steel from Ignis's ingot — only it can ignite the portal home.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.5b894b4f0fabe39176b9": "An undead warlock of a pagan cult. One of the four guardians of the Nether.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.5d0a44c923313313d4f4": "A massive golem forged from ancient metal. One of the four guardians of the Nether.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.6a949fff4fb90252575b": "Lord of Flame",
  "lanminecraft.escape_end_quests.0188f23907d5b573.7092e494d5579fdb80f0": "Netherite Monstrosity",
  "lanminecraft.escape_end_quests.0188f23907d5b573.80d1102e25349de7dc2d": "Ignitium Flint and Steel",
  "lanminecraft.escape_end_quests.0188f23907d5b573.833515212b371949bc85": "Blazing Fist",
  "lanminecraft.escape_end_quests.0188f23907d5b573.96d217cf166c98e1ffc8": "An enormous hand with a blazing eye. The last of the four guardians of the Nether.",
  "lanminecraft.escape_end_quests.0188f23907d5b573.a58293cce7368624e5d6": "Escape the Nether",
  "lanminecraft.escape_end_quests.0188f23907d5b573.b38c13caf8d4d1064d40": "Build the portal frame and ignite it with the Ignitium Flint and Steel. Home at last... or is it?",
  "lanminecraft.escape_end_quests.0188f23907d5b573.c0348a2f61ff993169c1": "The Gauntlet",
  "lanminecraft.escape_end_quests.0188f23907d5b573.cdc3572f5b19df261f72": "Servant of the Dark Cult",
  "lanminecraft.escape_end_quests.0188f23907d5b573.d2f9ecbf6cc99b23d1fa": "Return Home",
  "lanminecraft.escape_end_quests.0188f23907d5b573.fcd86c2cf3fa8655876c": "Key to the Portal",
  "lanminecraft.escape_end_quests.2445868387220123.0170472199871a71c04a": "Eye of the Unknown",
  "lanminecraft.escape_end_quests.2445868387220123.17b3c6267438314bf51f": "The Harbinger",
  "lanminecraft.escape_end_quests.2445868387220123.1a1b9c1a8877d8518267": "Key to the Heart",
  "lanminecraft.escape_end_quests.2445868387220123.1d4f7ffb16bdeafc9ce8": "The Heart of the End has fallen. Return to the real, living world. You're home.",
  "lanminecraft.escape_end_quests.2445868387220123.22b77af01c6aaed3c80c": "Ancient Remnant",
  "lanminecraft.escape_end_quests.2445868387220123.264106ae8768f4ee9369": "Use the drops from every Lord of the Cataclysm, along with those of the Wither and Warden, to craft the Eye of the Unknown — the key to summoning the Heart of the End.",
  "lanminecraft.escape_end_quests.2445868387220123.27b0f7177e4ecfb58f24": "Ancient Horror",
  "lanminecraft.escape_end_quests.2445868387220123.296ce80d248bc28be552": "A colossal sea horror from sunken cities.",
  "lanminecraft.escape_end_quests.2445868387220123.30132684ac208f3d873a": "The End?",
  "lanminecraft.escape_end_quests.2445868387220123.34b6ec93863eabd28060": "True Ending",
  "lanminecraft.escape_end_quests.2445868387220123.35aba87d27906de39aab": "Maledictus",
  "lanminecraft.escape_end_quests.2445868387220123.3fbdee448627f4743737": "The Leviathan",
  "lanminecraft.escape_end_quests.2445868387220123.4c4aabdaf9e9a748a277": "Descend into the Deep Dark and defeat the Warden. Its drop is needed to craft the Eye.",
  "lanminecraft.escape_end_quests.2445868387220123.525f340aa54d7cac725f": "Lord of the Depths",
  "lanminecraft.escape_end_quests.2445868387220123.6706ba0f40762559b12d": "An ancient evil from cursed pyramids.",
  "lanminecraft.escape_end_quests.2445868387220123.6a5cfa3e6a632019ba00": "Scylla",
  "lanminecraft.escape_end_quests.2445868387220123.6e4624af4de56f82fb4f": "Shard of Antiquity",
  "lanminecraft.escape_end_quests.2445868387220123.700f9220d95975fdf370": "Guardian of Darkness",
  "lanminecraft.escape_end_quests.2445868387220123.7410595ef1a39c5a0f7c": "Summon and defeat the Wither. Its Nether Star is needed to craft the Eye.",
  "lanminecraft.escape_end_quests.2445868387220123.81258b7c45d5e6c99bf2": "Warden",
  "lanminecraft.escape_end_quests.2445868387220123.8f061400891334de4b9b": "Heart of the End",
  "lanminecraft.escape_end_quests.2445868387220123.9d841b6c5fb89cfd2d40": "The mightiest of the Lords of the Cataclysm.",
  "lanminecraft.escape_end_quests.2445868387220123.a0020819dbff4c867bd0": "True Home",
  "lanminecraft.escape_end_quests.2445868387220123.a1a1ad1a0eb486d66db7": "Final Boss",
  "lanminecraft.escape_end_quests.2445868387220123.a385167af9b9b5f9f437": "Voice of the Storm",
  "lanminecraft.escape_end_quests.2445868387220123.a98fb241050f98300dd4": "An awakened guardian of an ancient citadel.",
  "lanminecraft.escape_end_quests.2445868387220123.afbc994364a2b8b4b48d": "Use the Eye to summon and defeat the Heart of the End. Only then will the path home open.",
  "lanminecraft.escape_end_quests.2445868387220123.bd97ddf8338f4f2f3313": "Harbinger of the End",
  "lanminecraft.escape_end_quests.2445868387220123.c49a0b9231743f765863": "Mistress of storms and lightning.",
