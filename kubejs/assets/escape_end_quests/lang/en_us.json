  "lanminecraft.escape_end_quests.info.032dc6e285c1c25b1a0e": "R - Roll",
  "lanminecraft.escape_end_quests.info.1cb0ba125f84c982b00b": "Information",
  "lanminecraft.escape_end_quests.info.2a114f911adf6e8f6a06": "Hotkeys:",
  "lanminecraft.escape_end_quests.info.32ddc68e60dae378e9c1": "&7This modpack is in Early Access, so bugs are possible. If something breaks, contact us on Boosty or Telegram.",
  "lanminecraft.escape_end_quests.info.4310d4e97f38e7699d6d": "H - Party (complete quests together with friends; use the invite icon)",
  "lanminecraft.escape_end_quests.info.4bde341f9c58c2e1f139": "J - Map Waypoint",
  "lanminecraft.escape_end_quests.info.5915ae9d73e762b66f4f": "&dYou begin in the End, on one of the outer islands. Your goal is to survive and gradually make your way to the central island, where the dragon awaits. The outer islands are scattered far apart, so you'll need to leap between them, throw ender pearls, build bridges, and later glide — and even fly. To get you started, here are three ender pearls to help you reach the nearest tree. Good luck!",
  "lanminecraft.escape_end_quests.info.8b36a344df04b59a5e23": "C - Zoom",
  "lanminecraft.escape_end_quests.info.8db8a5df860b6f939d5a": "M - Map",
  "lanminecraft.escape_end_quests.info.9037ca410112e7bf0735": "&7We recommend playing with the shaders already included in the modpack. They're configured for all custom dimensions, and the game simply looks and feels better with them.",
  "lanminecraft.escape_end_quests.info.981d50b2c02fe1f7136c": "&7Before facing the dragon, make sure you're prepared: gear up and build your strength, or the fight may end very quickly — and not in your favor...",
  "lanminecraft.escape_end_quests.info.e25c4421b6fda3ac251b": "Thank you for downloading the modpack and supporting its development!&r",
  "lanminecraft.escape_end_quests.info.e8e6a59041303b6f33bb": "G - Quests",
